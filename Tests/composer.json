{
  "name": "srw/logger-testing-suite",
  "description": "Unit testing framework for SRW Logger Plugin",
  "version": "1.0.0",
  "autoload": {
    "classmap": [
      "../Source/Public/Classes/",
      "../Source/Private/Classes/",
      "../Source/Private/Enumerations/",
      "../Source/Public/Attributes/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
            "Tests\\": "./"
        },
    "classmap": [
      "./"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "require": {
    "illuminate/support": "^13.23"
  }
}
